# Supabase — https://supabase.com/dashboard > Project Settings > API
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sitenin mutlak adresi — canonical, sitemap, JSON-LD ve OG görselleri buradan.
# Boş bırakılırsa Vercel'in otomatik deploy adresi, o da yoksa canlı domain kullanılır.
# Canlıya çıkarken: https://davetyerim.com
NEXT_PUBLIC_SITE_URL=


# ============================================================
# MEKAN ERİŞİM OTOMASYONU (outreach) — ayrıntılar: OUTREACH.md
# Bu bölüm boş bırakılırsa site normal çalışır, sadece /admin/outreach kapalı olur.
# ============================================================

# Service role anahtarı — Supabase > Project Settings > API > service_role.
# DİKKAT: RLS'i baypas eder. Asla NEXT_PUBLIC_ ile başlamamalı, asla git'e girmemeli.
SUPABASE_SERVICE_ROLE_KEY=

# Cron endpoint'ini koruyan gizli anahtar. Boşsa /api/cron/outreach çalışmaz.
# Üretmek için: openssl rand -base64 32
CRON_SECRET=

# Abonelik iptal bağlantılarını imzalar. Boşsa CRON_SECRET kullanılır.
# DEĞİŞTİRİRSENİZ daha önce gönderilmiş maillerdeki iptal linkleri geçersiz olur.
OUTREACH_UNSUBSCRIBE_SECRET=

# --- Keşif kaynağı ---
# google_places | directory
OUTREACH_SOURCE=google_places
# Google Cloud > Places API (New) anahtarı
GOOGLE_PLACES_API_KEY=

# Jenerik dizin adaptörü (yalnızca izinli olduğunuz kaynaklar için).
# Sayfaya gömülü Schema.org JSON-LD verisini okur, robots.txt'e uyar.
# OUTREACH_DIRECTORY_URL=https://ornek-dizin.com/dugun-salonlari/{city}?sayfa={page}
# OUTREACH_DIRECTORY_PAGES=2

# --- E-posta gönderimi (Resend) ---
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=isbirligi@davetyerim.com
OUTREACH_FROM_NAME=Davet Yerim
OUTREACH_REPLY_TO=
# Resend > Webhooks ile üretilen imza anahtarı (whsec_...)
RESEND_WEBHOOK_SECRET=

# true iken sistem keşfeder ve taslak üretir ama HİÇBİR mail göndermez.
# İlk kurulumda true bırakın.
OUTREACH_DRY_RUN=true

# --- Hız ve kapsam ayarları (hepsi isteğe bağlı) ---
# OUTREACH_CITIES=İstanbul,Ankara,İzmir,Antalya,Bursa
# OUTREACH_SEARCH_TERMS=düğün salonu,kır düğünü mekanı,balo salonu
# OUTREACH_ENRICH_PER_RUN=10
# OUTREACH_DRAFT_PER_RUN=20
# OUTREACH_SEND_PER_RUN=8
# OUTREACH_CRAWL_DELAY_MS=1200
# OUTREACH_FETCH_TIMEOUT_MS=8000
# OUTREACH_MAX_PAGES_PER_SITE=4
# OUTREACH_RUN_BUDGET_MS=45000

# Google Analytics 4 ölçüm ID'si — GA4 > Yönetici > Veri akışları > Web akışı.
# Boş bırakılırsa hiçbir analytics kodu sayfaya basılmaz.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML etiketi doğrulaması.
# Search Console > Mülk ekle > URL öneki > "HTML etiketi" yöntemindeki
# content="..." değeri. DNS TXT ile doğruladıysanız gerekmez, boş bırakın.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
